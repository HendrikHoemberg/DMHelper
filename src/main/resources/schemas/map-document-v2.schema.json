{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dmhelper/map-document-v2.schema.json",
  "title": "DMHelper Map Document Format v2",
  "description": "Internal schema for the MapDocument v2 JSON blob. Grid coordinates use [col, row] order (zero-indexed from top-left). Token positions are grid-cell coordinates relative to the canvas origin (top-left).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "grid", "layers"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 2 },
    "grid": { "$ref": "#/$defs/documentGrid" },
    "layers": { "type": "array", "items": { "$ref": "#/$defs/layer" } },
    "primitives": { "type": "array", "items": { "$ref": "#/$defs/primitive" } },
    "customTerrain": { "type": "array", "items": { "$ref": "#/$defs/terrain" } }
  },
  "$defs": {
    "documentGrid": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "cellSizePx", "gridType"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "cellSizePx": { "type": "integer", "minimum": 1 },
        "gridType": { "type": "string", "enum": ["square"] },
        "movementMode": { "type": "string", "enum": ["GRID", "FREEFORM"] },
        "showGrid": { "type": "boolean" }
      }
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "type"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["TERRAIN", "OBJECTS", "ANNOTATIONS", "IMAGE"] },
        "visible": { "type": "boolean" },
        "locked": { "type": "boolean" },
        "cells": { "type": "array", "items": { "$ref": "#/$defs/cell" } },
        "shapes": { "type": "array", "items": { "$ref": "#/$defs/shape" } },
        "image": { "$ref": "#/$defs/image" },
        "playerVisible": { "type": "boolean" }
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["col", "row"],
      "properties": {
        "col": { "type": "integer", "minimum": 0 },
        "row": { "type": "integer", "minimum": 0 },
        "terrain": { "type": "string" }
      }
    },
    "shape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "points"],
      "properties": {
        "type": { "type": "string", "enum": ["rect", "circle", "line", "polygon"] },
        "points": { "type": "array", "items": { "type": "number" } },
        "fill": { "type": "string" },
        "stroke": { "type": "string" },
        "strokeWidth": { "type": "number", "minimum": 0 },
        "label": { "type": "string" }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "description": "Background image placement. NOTE: x/y/width/height are in GRID CELLS, not pixels — the renderer multiplies each by grid.cellSizePx. To place an image 1:1 (one source pixel per grid pixel), set width/height to grid.width/grid.height, which requires the image to be exactly grid.width*cellSizePx by grid.height*cellSizePx pixels. This differs from map.tokens[] and map.threatPins[] in the campaign manifest, whose coordinates are in pixels.",
      "required": ["assetRef", "x", "y", "width", "height"],
      "properties": {
        "assetRef": { "$ref": "https://dmhelper/campaign-format-v2.schema.json#/$defs/key" },
        "x": { "type": "number", "description": "Left edge in grid cells, relative to the canvas origin (top-left)." },
        "y": { "type": "number", "description": "Top edge in grid cells, relative to the canvas origin (top-left)." },
        "width": { "type": "number", "exclusiveMinimum": 0, "description": "Drawn width in grid cells." },
        "height": { "type": "number", "exclusiveMinimum": 0, "description": "Drawn height in grid cells." },
        "rotationDeg": { "type": "number" },
        "locked": { "type": "boolean" },
        "calibration": { "$ref": "#/$defs/calibration" }
      }
    },
    "primitive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["ROOM", "CORRIDOR", "DOOR", "REGION"] },
        "startCol": { "type": "integer", "minimum": 0 },
        "startRow": { "type": "integer", "minimum": 0 },
        "endCol": { "type": "integer", "minimum": 0 },
        "endRow": { "type": "integer", "minimum": 0 },
        "terrain": { "type": "string" },
        "key": { "type": "string" },
        "label": { "type": "string" },
        "playerVisible": { "type": "boolean" }
      }
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "description": "Record of the two-point grid calibration the DM performed. Descriptive only — the renderer draws from image.x/y/width/height and never re-applies this. Points a and b are in grid cells (same units as image.x/y); the offsets are the resulting image origin in pixels.",
      "required": ["ax", "ay", "bx", "by", "cellsBetween", "offsetXPx", "offsetYPx"],
      "properties": {
        "ax": { "type": "number", "description": "First calibration point, x in grid cells." },
        "ay": { "type": "number", "description": "First calibration point, y in grid cells." },
        "bx": { "type": "number", "description": "Second calibration point, x in grid cells." },
        "by": { "type": "number", "description": "Second calibration point, y in grid cells." },
        "cellsBetween": { "type": "number", "minimum": 0, "description": "Number of cells the DM declared between points a and b." },
        "offsetXPx": { "type": "number", "description": "Resulting image.x in pixels (image.x * grid.cellSizePx)." },
        "offsetYPx": { "type": "number", "description": "Resulting image.y in pixels (image.y * grid.cellSizePx)." }
      }
    },
    "terrain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "name", "fill"],
      "properties": {
        "key": { "type": "string" },
        "name": { "type": "string" },
        "fill": { "type": "string" },
        "walkable": { "type": "boolean" }
      }
    }
  }
}
