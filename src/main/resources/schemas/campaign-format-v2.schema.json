      }
    },
    "sceneTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "kind", "sortOrder"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "kind": { "type": "string", "enum": ["CHOICE", "ENTRANCE", "EXIT"] },
        "label": { "type": "string" },
        "targetSceneRef": { "$ref": "#/$defs/contentReference" },
        "externalDestination": { "type": "string" },
        "condition": { "type": "string" },
        "dmNote": { "type": "string" },
        "sourceLocator": { "type": "string" },
        "sortOrder": { "type": "integer" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "CHOICE" } }, "required": ["kind"] },
          "then": { "required": ["targetSceneRef"], "not": { "required": ["externalDestination"] } }
        },
        {
          "if": { "properties": { "kind": { "const": "ENTRANCE" } }, "required": ["kind"] },
          "then": { "oneOf": [
            { "required": ["targetSceneRef"], "not": { "required": ["externalDestination"] } },
            { "required": ["externalDestination"], "not": { "required": ["targetSceneRef"] } }
          ] }
        },
        {
          "if": { "properties": { "kind": { "const": "EXIT" } }, "required": ["kind"] },
          "then": { "oneOf": [
            { "required": ["targetSceneRef"], "not": { "required": ["externalDestination"] } },
            { "required": ["externalDestination"], "not": { "required": ["targetSceneRef"] } }
          ] }
        }
      ]
    },
