{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dmhelper/campaign-format-v2.schema.json",
  "title": "DMHelper Campaign Export Format v2",
  "description": "Schema for the .dmcampaign.json v2 export/import format. All coordinate positions use grid-cell units. Grid coordinates use [col, row] order (zero-indexed from top-left). Currency amounts are in the units specified by the currency field (cp, sp, ep, gp, pp). Dates use ISO-8601 format.",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "metadata", "campaign", "assets", "party", "customStatBlocks", "customSpells", "customConditions", "customRules", "customEquipment", "customMagicItems", "customClasses", "customSpecies", "customBackgrounds", "customFeats", "handouts", "maps", "encounters", "notes", "quickNotes", "assignments", "ledgerEntries", "timelineEvents", "adventures", "diceRolls"],
  "properties": {
    "formatVersion": { "type": "integer", "const": 2 },
    "metadata": { "$ref": "#/$defs/metadata" },
    "campaign": { "$ref": "#/$defs/campaign" },
    "assets": { "type": "array", "items": { "$ref": "#/$defs/asset" } },
    "party": { "type": "array", "items": { "$ref": "#/$defs/partyMember" } },
    "customStatBlocks": { "type": "array", "items": { "$ref": "#/$defs/statBlock" } },
    "customSpells": { "type": "array", "items": { "$ref": "#/$defs/customSpell" } },
    "customConditions": { "type": "array", "items": { "$ref": "#/$defs/customCondition" } },
    "customRules": { "type": "array", "items": { "$ref": "#/$defs/customRule" } },
    "customEquipment": { "type": "array", "items": { "$ref": "#/$defs/customEquipment" } },
    "customMagicItems": { "type": "array", "items": { "$ref": "#/$defs/customMagicItem" } },
    "customClasses": { "type": "array", "items": { "$ref": "#/$defs/customClass" } },
    "customSpecies": { "type": "array", "items": { "$ref": "#/$defs/customSpecies" } },
    "customBackgrounds": { "type": "array", "items": { "$ref": "#/$defs/customBackground" } },
    "customFeats": { "type": "array", "items": { "$ref": "#/$defs/customFeat" } },
    "handouts": { "type": "array", "items": { "$ref": "#/$defs/handout" } },
    "maps": { "type": "array", "items": { "$ref": "#/$defs/map" } },
    "encounters": { "type": "array", "items": { "$ref": "#/$defs/encounter" } },
    "notes": { "type": "array", "items": { "$ref": "#/$defs/note" } },
    "quickNotes": { "type": "array", "items": { "$ref": "#/$defs/quickNote" } },
    "assignments": { "type": "array", "items": { "$ref": "#/$defs/assignment" } },
    "ledgerEntries": { "type": "array", "items": { "$ref": "#/$defs/ledgerEntry" } },
    "timelineEvents": { "type": "array", "items": { "$ref": "#/$defs/timelineEvent" } },
    "adventures": { "type": "array", "items": { "$ref": "#/$defs/adventure" } },
    "session": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/session" }] },
    "diceRolls": { "type": "array", "items": { "$ref": "#/$defs/diceRoll" } },
    "quests": { "type": "array", "items": { "$ref": "#/$defs/quest" } },
    "annotations": { "type": "array", "items": { "$ref": "#/$defs/sourceAnnotation" } }
  },
  "$defs": {
    "key": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,99}$",
      "maxLength": 100
    },
    "packageReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "type", "key"],
      "properties": {
        "scope": { "type": "string", "const": "PACKAGE" },
        "type": { "$ref": "#/$defs/contentType" },
        "key": { "$ref": "#/$defs/key" }
      }
    },
    "catalogReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "type", "ruleset", "sourceKey"],
      "properties": {
        "scope": { "type": "string", "const": "CATALOG" },
        "type": { "$ref": "#/$defs/contentType" },
        "ruleset": { "type": "string", "minLength": 1 },
        "sourceKey": { "type": "string", "minLength": 1 }
      }
    },
    "contentReference": {
      "oneOf": [
        { "$ref": "#/$defs/packageReference" },
        { "$ref": "#/$defs/catalogReference" }
      ]
    },
    "contentType": {
      "type": "string",
      "enum": [
        "CAMPAIGN", "ADVENTURE", "CHAPTER", "SCENE",
        "MAP", "TOKEN",
        "ENCOUNTER", "ENCOUNTER_WAVE", "COMBATANT", "COMBAT_LOG_ENTRY",
        "PARTY_MEMBER", "CHARACTER_SHEET", "SHEET_RESOURCE",
        "NOTE", "QUICK_NOTE", "HANDOUT",
        "ASSIGNMENT", "LEDGER_ENTRY", "TIMELINE_EVENT",
        "SESSION", "SESSION_SCENE_VISIT",
        "STATBLOCK", "SPELL", "CONDITION", "RULE", "EQUIPMENT_ITEM", "MAGIC_ITEM",
        "CLASS", "SPECIES", "BACKGROUND", "FEAT",
        "DICE_ROLL",
        "TRANSITION", "QUEST", "OBJECTIVE", "SOURCE_ANNOTATION", "SESSION_OBJECTIVE_CHANGE"
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packageKey", "createdAt", "generator", "catalogVersion", "catalogSha256", "exclusions"],
      "properties": {
        "packageKey": { "$ref": "#/$defs/key" },
        "createdAt": { "type": "string", "format": "date-time" },
        "generator": { "type": "string", "minLength": 1 },
        "catalogVersion": { "type": "string", "minLength": 1 },
        "catalogSha256": { "type": "string", "minLength": 1 },
        "exclusions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["COMBAT_LOG", "DICE_HISTORY"] }
        }
      }
    },
    "campaign": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "name", "createdAt", "settings"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "settings": { "$ref": "#/$defs/campaignSettings" },
        "currentSceneRef": { "$ref": "#/$defs/contentReference" }
      }
    },
    "campaignSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["levelingMode"],
      "properties": {
        "levelingMode": { "type": "string", "enum": ["XP", "MILESTONE"] },
        "calendar": { "$ref": "#/$defs/calendarConfig" },
        "currentDate": { "$ref": "#/$defs/inGameDate" }
      }
    },
    "calendarConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["monthLengths", "monthNames", "weekdayNames"],
      "properties": {
        "monthLengths": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "minItems": 1 },
        "monthNames": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
        "weekdayNames": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 }
      }
    },
    "inGameDate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["year", "month", "day"],
      "properties": {
        "year": { "type": "integer" },
        "month": { "type": "integer", "minimum": 0 },
        "day": { "type": "integer", "minimum": 1 }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "status", "startedAt", "presentationMode", "attendeeRefs", "sceneVisits"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "status": { "type": "string", "enum": ["RUNNING", "PAUSED", "REVIEW"] },
        "startedAt": { "type": "string", "format": "date-time" },
        "pausedAt": { "type": "string", "format": "date-time" },
        "reviewStartedAt": { "type": "string", "format": "date-time" },
        "startInGameDate": { "type": "object", "additionalProperties": false, "required": ["year", "month", "day"], "properties": { "year": { "type": "integer" }, "month": { "type": "integer" }, "day": { "type": "integer" } } },
        "planNoteRef": { "$ref": "#/$defs/contentReference" },
        "workspaceMapRef": { "$ref": "#/$defs/contentReference" },
        "presentationMode": { "type": "string", "enum": ["CURTAIN", "MAP", "HANDOUT"] },
        "presentedRef": { "$ref": "#/$defs/contentReference" },
        "attendeeRefs": { "type": "array", "items": { "$ref": "#/$defs/contentReference" } },
        "sceneVisits": { "type": "array", "items": { "$ref": "#/$defs/sessionSceneVisit" } },
        "draftBody": { "type": "string" },
        "objectiveChanges": { "type": "array", "items": { "$ref": "#/$defs/sessionObjectiveChange" } }
      },
      "allOf": [
        {
          "if": { "properties": { "presentationMode": { "const": "CURTAIN" } }, "required": ["presentationMode"] },
          "then": { "not": { "required": ["presentedRef"] } }
        },
        {
          "if": { "properties": { "presentationMode": { "const": "MAP" } }, "required": ["presentationMode"] },
          "then": {
            "required": ["presentedRef"],
            "properties": { "presentedRef": { "allOf": [
              { "$ref": "#/$defs/contentReference" },
              { "properties": { "type": { "const": "MAP" } } }
            ] } }
          }
        },
        {
          "if": { "properties": { "presentationMode": { "const": "HANDOUT" } }, "required": ["presentationMode"] },
          "then": {
            "required": ["presentedRef"],
            "properties": { "presentedRef": { "allOf": [
              { "$ref": "#/$defs/contentReference" },
              { "properties": { "type": { "const": "HANDOUT" } } }
            ] } }
          }
        },
        {
          "if": { "properties": { "status": { "const": "REVIEW" } }, "required": ["status"] },
          "then": { "required": ["draftBody"], "properties": { "draftBody": { "minLength": 1 } } },
          "else": { "not": { "required": ["draftBody"] } }
        }
      ]
    },
    "sessionSceneVisit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "sceneRef", "visitedAt"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "sceneRef": { "$ref": "#/$defs/contentReference" },
        "visitedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "path", "mediaType", "sizeBytes", "sha256"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "path": { "type": "string", "minLength": 1, "maxLength": 240, "pattern": "^assets/(maps|handouts|portraits)/[^/]+(?:/[^/]+)*$" },
        "mediaType": { "type": "string", "enum": ["image/png", "image/jpeg", "image/gif", "image/webp"] },
        "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 104857600 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "originalName": { "type": "string" }
      }
    },
    "partyMember": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "characterName", "playerName", "classAndLevel", "ac", "maxHp", "currentHp", "initiativeBonus", "speed", "passivePerception", "passiveInsight", "passiveInvestigation", "active"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "characterName": { "type": "string" },
        "playerName": { "type": "string" },
        "classAndLevel": { "type": "string" },
        "ac": { "type": "integer", "minimum": 0 },
        "maxHp": { "type": "integer", "minimum": 1 },
        "currentHp": { "type": "integer", "minimum": 0 },
        "initiativeBonus": { "type": "integer" },
        "speed": { "type": "integer", "minimum": 0 },
        "passivePerception": { "type": "integer" },
        "passiveInsight": { "type": "integer" },
        "passiveInvestigation": { "type": "integer" },
        "notes": { "type": "string" },
        "active": { "type": "boolean" },
        "tempHp": { "type": "integer", "minimum": 0 },
        "inspiration": { "type": "boolean" },
        "exhaustion": { "type": "integer", "minimum": 0, "maximum": 6 },
        "deathSaveSuccesses": { "type": "integer", "minimum": 0, "maximum": 3 },
        "deathSaveFailures": { "type": "integer", "minimum": 0, "maximum": 3 },
        "concentratingOn": { "type": "string", "maxLength": 255 },
        "conditionsJson": { "type": "string" },
        "sheet": { "$ref": "#/$defs/sheet" }
      }
    },
    "sheet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "xp", "hitDiceUsed"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "abilityScores": { "type": "object" },
        "classLevels": { "type": "array", "items": { "$ref": "#/$defs/classLevel" } },
        "proficiencies": { "type": "object" },
        "speciesRef": { "$ref": "#/$defs/contentReference" },
        "backgroundRef": { "$ref": "#/$defs/contentReference" },
        "featRefs": { "type": "array", "items": { "$ref": "#/$defs/contentReference" } },
        "xp": { "type": "integer", "minimum": 0 },
        "overrides": { "type": "object" },
        "hitDiceUsed": { "type": "integer", "minimum": 0 },
        "resources": { "type": "array", "items": { "$ref": "#/$defs/resource" } },
        "spells": { "type": "array", "items": { "$ref": "#/$defs/spellRef" } },
        "spellSlotsUsed": { "type": "object" },
        "attacks": { "type": "array", "items": { "$ref": "#/$defs/attack" } },
        "features": { "type": "array", "items": { "$ref": "#/$defs/feature" } }
      }
    },
    "classLevel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classRef", "level"],
      "properties": {
        "classRef": { "$ref": "#/$defs/contentReference" },
        "level": { "type": "integer", "minimum": 1 },
        "hitDieRolls": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
        "subclassRef": { "$ref": "#/$defs/contentReference" }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "name", "maxUses", "currentUses", "resetRule"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "name": { "type": "string" },
        "maxUses": { "type": "integer", "minimum": 0 },
        "currentUses": { "type": "integer", "minimum": 0 },
        "resetRule": { "type": "string", "enum": ["SHORT_REST", "LONG_REST", "NEVER"] }
      }
    },
    "spellRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spellRef", "prepared"],
      "properties": {
        "spellRef": { "$ref": "#/$defs/contentReference" },
        "prepared": { "type": "boolean" },
        "sourceClassRef": { "$ref": "#/$defs/contentReference" }
      }
    },
    "attack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "name", "attackBonus", "damageExpression"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "name": { "type": "string" },
        "attackBonus": { "type": "integer" },
        "damageExpression": { "type": "string" },
        "damageType": { "type": "string" },
        "range": { "type": "string" },
        "properties": { "type": "string" },
        "ammunition": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "name", "actionType"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "name": { "type": "string" },
        "actionType": { "type": "string", "enum": ["ACTION", "BONUS_ACTION", "REACTION", "FREE", "PASSIVE", "OTHER"] },
        "source": { "type": "string" },
        "body": { "type": "string" },
        "resourceName": { "type": "string" }
      }
    },
    "statBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "name", "ac", "strScore", "dexScore", "conScore", "intScore", "wisScore", "chaScore", "xp", "createdAt"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "sourceKey": { "type": "string" },
        "name": { "type": "string" },
        "cr": { "type": "string" },
        "type": { "type": "string" },
        "size": { "type": "string" },
        "alignment": { "type": "string" },
        "ac": { "type": "integer" },
        "hp": { "type": "string" },
        "speed": { "type": "string" },
        "strScore": { "type": "integer" },
        "dexScore": { "type": "integer" },
        "conScore": { "type": "integer" },
        "intScore": { "type": "integer" },
        "wisScore": { "type": "integer" },
        "chaScore": { "type": "integer" },
        "strSave": { "type": "integer" },
        "dexSave": { "type": "integer" },
        "conSave": { "type": "integer" },
        "intSave": { "type": "integer" },
        "wisSave": { "type": "integer" },
        "chaSave": { "type": "integer" },
        "skills": { "type": "string" },
        "damageVulnerabilities": { "type": "string" },
        "damageResistances": { "type": "string" },
        "damageImmunities": { "type": "string" },
        "conditionImmunities": { "type": "string" },
        "senses": { "type": "string" },
        "languages": { "type": "string" },
        "traits": { "type": "string" },
        "actions": { "type": "string" },
        "bonusActions": { "type": "string" },
        "reactions": { "type": "string" },
        "legendaryActions": { "type": "string" },
        "legendaryDescription": { "type": "string" },
        "lairActions": { "type": "string" },
        "xp": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "sourceTitle": { "type": "string" },
        "editionVersion": { "type": "string" },
        "sourceLocator": { "type": "string" },
        "licenseClassification": { "type": "string", "enum": ["ORIGINAL", "SRD", "OGL_COMPATIBLE", "THIRD_PARTY", "NON_REDISTRIBUTABLE", "UNKNOWN"] },
        "importedAt": { "type": "string", "format": "date-time" },
        "converterId": { "type": "string" },
        "converterVersion": { "type": "string" },
        "sourceHash": { "type": "string" },
        "extractionConfidence": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW", "UNKNOWN"] }
      }
    },
    "customSpell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "name", "level"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "sourceKey": { "type": "string" },
        "name": { "type": "string" },
        "level": { "type": "integer", "minimum": 0 },
        "school": { "type": "string" },
        "castingTime": { "type": "string" },
        "range": { "type": "string" },
        "components": { "type": "string" },
        "duration": { "type": "string" },
        "description": { "type": "string" },
        "higherLevel": { "type": "string" },
        "ritual": { "type": "boolean" },
        "concentration": { "type": "boolean" },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "customCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "name"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "sourceKey": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "customRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "name", "sortOrder"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "sourceKey": { "type": "string" },
        "name": { "type": "string" },
        "body": { "type": "string" },
        "parentKey": { "type": "string" },
        "sortOrder": { "type": "integer" },
        "ruleset": { "type": "string" },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "customEquipment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "name"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "sourceKey": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string", "enum": ["WEAPON", "ARMOR", "GEAR", "TOOL"] },
        "cost": { "type": "string" },
        "weight": { "type": "string" },
        "properties": { "type": "string" },
        "description": { "type": "string" },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "customMagicItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "name"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "sourceKey": { "type": "string" },
        "name": { "type": "string" },
        "rarity": { "type": "string" },
        "category": { "type": "string" },
        "type": { "type": "string" },
        "description": { "type": "string" },
        "weight": { "type": "string" },
        "cost": { "type": "string" },
        "requiresAttunement": { "type": "boolean" },
        "attunementDetail": { "type": "string" },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "customClass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "name"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "sourceKey": { "type": "string" },
        "name": { "type": "string" },
        "hitDie": { "type": "string" },
        "subclassOf": { "type": "string" },
        "description": { "type": "string" },
        "savingThrows": { "type": "string" },
        "features": { "type": "string" },
        "spellcasting": { "type": "string" },
        "proficiencies": { "type": "string" },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "customSpecies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "name"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "sourceKey": { "type": "string" },
        "name": { "type": "string" },
        "size": { "type": "string" },
        "speed": { "type": "string" },
        "traits": { "type": "string" },
        "description": { "type": "string" },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "customBackground": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "name"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "sourceKey": { "type": "string" },
        "name": { "type": "string" },
        "abilityScores": { "type": "string" },
        "featRef": { "type": "string" },
        "skills": { "type": "string" },
        "tools": { "type": "string" },
        "description": { "type": "string" },
        "equipment": { "type": "string" },
        "provenance": { "$ref": "#/$defs/provenance" }
