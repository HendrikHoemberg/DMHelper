{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dmhelper/campaign-format.schema.json",
  "title": "DMHelper Campaign Export Format",
  "description": "Schema for the .dmcampaign.json export/import format. All coordinate positions use pixel units with origin at top-left. Token sizes are in cell units (1 cell = cellSizePx pixels). Grid coordinates use [col, row] order (zero-indexed from top-left). Currency amounts are in the units specified by the currency field (cp, sp, ep, gp, pp). Dates use ISO-8601 format.",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "campaign"],
  "properties": {
    "formatVersion": { "type": "integer", "const": 1 },
    "campaign": { "$ref": "#/$defs/campaign" },
    "party": { "type": "array", "items": { "$ref": "#/$defs/partyMember" } },
    "statBlocks": { "type": "array", "items": { "$ref": "#/$defs/statBlock" } },
    "handouts": { "type": "array", "items": { "$ref": "#/$defs/handout" } },
    "maps": { "type": "array", "items": { "$ref": "#/$defs/map" } },
    "encounters": { "type": "array", "items": { "$ref": "#/$defs/encounter" } },
    "notes": { "type": "array", "items": { "$ref": "#/$defs/note" } },
    "quicknotes": { "type": "array", "items": { "$ref": "#/$defs/quicknote" } },
    "assignments": { "type": "array", "items": { "$ref": "#/$defs/assignment" } },
    "ledger": { "type": "array", "items": { "$ref": "#/$defs/ledgerEntry" } },
    "timeline": { "type": "array", "items": { "$ref": "#/$defs/timelineEvent" } },
    "adventures": { "type": "array", "items": { "$ref": "#/$defs/adventure" } }
  },
  "$defs": {
    "campaign": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "partyMember": {
      "type": "object",
      "additionalProperties": false,
      "required": ["characterName", "playerName", "classAndLevel", "ac", "maxHp", "initiativeBonus", "speed", "passivePerception", "passiveInsight", "passiveInvestigation", "active"],
      "properties": {
        "characterName": { "type": "string" },
        "playerName": { "type": "string" },
        "classAndLevel": { "type": "string" },
        "ac": { "type": "integer", "minimum": 0 },
        "maxHp": { "type": "integer", "minimum": 1 },
        "initiativeBonus": { "type": "integer" },
        "speed": { "type": "integer", "minimum": 0 },
        "passivePerception": { "type": "integer" },
        "passiveInsight": { "type": "integer" },
        "passiveInvestigation": { "type": "integer" },
        "notes": { "type": "string" },
        "active": { "type": "boolean" },
        "sheet": { "$ref": "#/$defs/sheet" }
      }
    },
    "sheet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["xp", "hitDiceUsed"],
      "properties": {
        "abilityScores": { "type": "object" },
        "classLevels": { "type": "array", "items": { "$ref": "#/$defs/classLevel" } },
        "proficiencies": { "type": "object" },
        "speciesKey": { "type": "string" },
        "backgroundKey": { "type": "string" },
        "featRefs": { "type": "array", "items": { "type": "string" } },
        "xp": { "type": "integer", "minimum": 0 },
        "overrides": { "type": "object" },
        "hitDiceUsed": { "type": "integer", "minimum": 0 },
        "resources": { "type": "array", "items": { "$ref": "#/$defs/resource" } },
        "spells": { "type": "array", "items": { "$ref": "#/$defs/spellRef" } },
        "spellSlotsUsed": { "type": "object" }
      }
    },
    "classLevel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classSourceKey", "level"],
      "properties": {
        "classSourceKey": { "type": "string" },
        "level": { "type": "integer", "minimum": 1 },
        "hitDieRolls": { "type": "array", "items": { "type": "integer", "minimum": 1 } }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "maxUses", "currentUses", "resetRule"],
      "properties": {
        "name": { "type": "string" },
        "maxUses": { "type": "integer", "minimum": 0 },
        "currentUses": { "type": "integer", "minimum": 0 },
        "resetRule": { "type": "string", "enum": ["SHORT_REST", "LONG_REST", "DAWN", "DUSK", "MANUAL"] }
      }
    },
    "spellRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spellKey", "prepared", "sourceClass"],
      "properties": {
        "spellKey": { "type": "string" },
        "prepared": { "type": "boolean" },
        "sourceClass": { "type": "string" }
      }
    },
    "statBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "ac", "strScore", "dexScore", "conScore", "intScore", "wisScore", "chaScore", "xp"],
      "properties": {
        "sourceKey": { "type": "string" },
        "name": { "type": "string" },
        "cr": { "type": "string" },
        "type": { "type": "string" },
        "size": { "type": "string" },
        "alignment": { "type": "string" },
        "ac": { "type": "integer" },
        "hp": { "type": "string" },
        "speed": { "type": "string" },
        "strScore": { "type": "integer" },
        "dexScore": { "type": "integer" },
        "conScore": { "type": "integer" },
        "intScore": { "type": "integer" },
        "wisScore": { "type": "integer" },
        "chaScore": { "type": "integer" },
        "strSave": { "type": "integer" },
        "dexSave": { "type": "integer" },
        "conSave": { "type": "integer" },
        "intSave": { "type": "integer" },
        "wisSave": { "type": "integer" },
        "chaSave": { "type": "integer" },
        "skills": { "type": "string" },
        "damageVulnerabilities": { "type": "string" },
        "damageResistances": { "type": "string" },
        "damageImmunities": { "type": "string" },
        "conditionImmunities": { "type": "string" },
        "senses": { "type": "string" },
        "languages": { "type": "string" },
        "traits": { "type": "string" },
        "actions": { "type": "string" },
        "bonusActions": { "type": "string" },
        "reactions": { "type": "string" },
        "legendaryActions": { "type": "string" },
        "legendaryDescription": { "type": "string" },
        "lairActions": { "type": "string" },
        "xp": { "type": "integer" }
      }
    },
    "handout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "fileName", "contentType", "imageData"],
      "properties": {
        "title": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "fileName": { "type": "string" },
        "contentType": { "type": "string", "enum": ["image/png", "image/jpeg", "image/gif", "image/webp"] },
        "imageData": { "type": "string", "pattern": "^data:image/(png|jpeg|gif|webp);base64," }
      }
    },
    "map": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "grid", "document"],
      "properties": {
        "key": { "type": "string", "description": "Map key (UUID string for v1)." },
        "name": { "type": "string", "description": "Map display name." },
        "grid": { "$ref": "#/$defs/mapGrid" },
        "movementMode": { "type": "string", "enum": ["GRID", "FREEFORM"], "description": "Movement mode on this map." },
        "showGrid": { "type": "boolean" },
        "document": { "$ref": "https://dmhelper/map-document.schema.json" },
        "tokens": { "type": "array", "items": { "$ref": "#/$defs/token" } }
      }
    },
    "mapGrid": {
      "type": "object",
      "additionalProperties": false,
      "required": ["w", "h", "cellPx"],
      "properties": {
        "w": { "type": "integer", "minimum": 1, "description": "Grid width in cells." },
        "h": { "type": "integer", "minimum": 1, "description": "Grid height in cells." },
        "cellPx": { "type": "integer", "minimum": 1, "description": "Cell size in pixels." },
        "gridType": { "type": "string", "enum": ["SQUARE"], "description": "Grid type. Uppercase SQUARE for v1 campaign format." }
      }
    },
    "token": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "positionX", "positionY", "sizeCols", "sizeRows", "hidden", "dead"],
      "properties": {
        "id": { "type": "string", "description": "Token identifier (non-empty string for v1)." },
        "name": { "type": "string" },
        "kind": { "type": "string", "enum": ["creature", "character", "hazard", "effect"] },
        "color": { "type": "string" },
        "positionX": { "type": "integer", "minimum": 0, "description": "Token position X in pixels." },
        "positionY": { "type": "integer", "minimum": 0, "description": "Token position Y in pixels." },
        "sizeCols": { "type": "integer", "minimum": 1, "description": "Token width in cell units." },
        "sizeRows": { "type": "integer", "minimum": 1, "description": "Token height in cell units." },
        "hidden": { "type": "boolean" },
        "statBlockKey": { "type": "string", "description": "StatBlock sourceKey (name-based v1 reference)." },
        "partyMemberName": { "type": "string", "description": "Party member character name (name-based v1 reference)." },
        "currentHp": { "type": "integer" },
        "maxHp": { "type": "integer" },
        "dead": { "type": "boolean" },
        "notes": { "type": "string" }
      }
    },
    "encounter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "combatants"],
      "properties": {
        "name": { "type": "string" },
        "combatants": { "type": "array", "items": { "$ref": "#/$defs/combatant" } },
        "status": { "type": "string", "enum": ["PLANNED", "ACTIVE", "DONE"] },
        "round": { "type": "integer", "minimum": 0 },
        "activeTurnIndex": { "type": "integer" },
        "logSequence": { "type": "integer", "minimum": 0 },
        "lairActionName": { "type": "string" },
        "lairActionDescription": { "type": "string" },
        "encounterKey": { "type": "string", "description": "Encounter key (name-based v1 reference)." },
        "map": { "type": "string", "description": "Map name (name-based v1 reference)." }
      }
    },
    "combatant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "initiative", "tieBreaker", "sortOrder", "maxHp", "currentHp", "tempHp", "kind", "groupLeader", "defeated", "hidden", "concentrationCheckPending", "legendaryActionsUsed", "legendaryResistancesUsed", "legendaryActionsMax", "legendaryResistancesMax"],
      "properties": {
        "name": { "type": "string" },
        "initiative": { "type": "integer" },
        "tieBreaker": { "type": "integer" },
        "sortOrder": { "type": "integer" },
        "maxHp": { "type": "integer", "minimum": 0 },
        "currentHp": { "type": "integer", "minimum": 0 },
        "tempHp": { "type": "integer", "minimum": 0 },
        "kind": { "type": "string", "enum": ["player", "creature"] },
        "groupId": { "type": "string" },
        "groupLeader": { "type": "boolean" },
        "tokenId": { "type": "string", "description": "Token identifier (name-based v1 reference)." },
        "statBlockKey": { "type": "string", "description": "StatBlock sourceKey (name-based v1 reference)." },
        "partyMemberName": { "type": "string", "description": "Party member character name (name-based v1 reference)." },
        "defeated": { "type": "boolean" },
        "hidden": { "type": "boolean" },
        "conditionsJson": { "type": "string" },
        "concentratingOn": { "type": "string" },
        "concentrationCheckPending": { "type": "boolean" },
        "legendaryActionsUsed": { "type": "integer", "minimum": 0 },
        "legendaryResistancesUsed": { "type": "integer", "minimum": 0 },
        "legendaryActionsMax": { "type": "integer", "minimum": 0 },
        "legendaryResistancesMax": { "type": "integer", "minimum": 0 },
        "rechargedAbilities": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "title"],
      "properties": {
        "type": { "type": "string", "enum": ["NPC", "LOCATION", "QUEST", "SESSION_LOG", "SESSION_PLAN", "GENERIC"] },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "tags": { "type": "string" },
        "dmOnly": { "type": "boolean" }
      }
    },
    "quicknote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetType", "targetRef", "body"],
      "properties": {
        "targetType": { "type": "string", "enum": ["CAMPAIGN", "MAP", "PARTY_MEMBER", "STATBLOCK", "NOTE", "HANDOUT", "ENCOUNTER", "SCENE"] },
        "targetRef": { "type": "string", "description": "Target reference - the referenced entity's name or key (name-based v1 reference)." },
        "body": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time", "description": "ISO-8601 timestamp of when the quick note was created." }
      }
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "holderName": { "type": "string" },
        "magicItemKey": { "type": "string" },
        "equipmentItemKey": { "type": "string" },
        "customText": { "type": "string" },
        "quantity": { "type": "integer", "minimum": 0 },
        "attuned": { "type": "boolean" }
      }
    },
    "ledgerEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "timestamp", "kind", "direction"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "timestamp": { "type": "string", "format": "date-time", "description": "ISO-8601 timestamp of the ledger entry." },
        "inGameYear": { "type": "integer", "description": "In-game year for dating the entry." },
        "inGameMonth": { "type": "integer", "minimum": 1, "maximum": 12, "description": "In-game month (1-12)." },
        "inGameDay": { "type": "integer", "minimum": 1, "maximum": 31, "description": "In-game day (1-31)." },
        "kind": { "type": "string", "enum": ["GOLD", "ITEM"] },
        "direction": { "type": "string", "enum": ["GAIN", "SPEND"] },
        "amount": { "type": "number", "description": "Currency amount in the units specified by the currency field." },
        "currency": { "type": "string", "description": "Currency denomination (cp, sp, ep, gp, pp)." },
        "holder": { "type": "string" },
        "note": { "type": "string" },
        "itemAssignmentRef": { "type": "string", "format": "uuid", "description": "UUID reference to an assignment entry." }
      }
    },
    "timelineEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "inGameYear", "inGameMonth", "inGameDay"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "inGameYear": { "type": "integer" },
        "inGameMonth": { "type": "integer", "minimum": 1, "maximum": 12 },
        "inGameDay": { "type": "integer", "minimum": 1, "maximum": 31 },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "noteTitle": { "type": "string", "description": "Note title (name-based v1 reference)." }
      }
    },
    "adventure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sortOrder", "chapters"],
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "sourceAttribution": { "type": "string" },
        "sortOrder": { "type": "integer" },
        "chapters": { "type": "array", "items": { "$ref": "#/$defs/chapter" } }
      }
    },
    "chapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "sortOrder", "scenes"],
      "properties": {
        "title": { "type": "string" },
        "intro": { "type": "string" },
        "sortOrder": { "type": "integer" },
        "scenes": { "type": "array", "items": { "$ref": "#/$defs/scene" } }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "sortOrder"],
      "properties": {
        "title": { "type": "string" },
        "sceneKey": { "type": "string", "description": "The scene identifier (name-based v1 reference)." },
        "body": { "type": "string" },
        "status": { "type": "string", "enum": ["UNVISITED", "VISITED", "DONE"] },
        "sortOrder": { "type": "integer" },
        "map": { "type": "string", "description": "Map name reference for v1." },
        "pin": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y"],
          "properties": {
            "x": { "type": "integer", "description": "Pin X position in pixels." },
            "y": { "type": "integer", "description": "Pin Y position in pixels." }
          }
        },
        "encounter": { "type": "string", "description": "Encounter key (name-based v1 reference)." },
        "statblocks": { "type": "array", "items": { "type": "string" }, "description": "StatBlock sourceKeys (name-based v1 references)." },
        "handouts": { "type": "array", "items": { "type": "string" }, "description": "Handout titles (name-based v1 references)." }
      }
    }
  }
}
